# Публичный адрес сайта
SITE_URL=https://saitmagnitov.ru
APP_PORT=3000

# PostgreSQL для следующего этапа
POSTGRES_DB=site_magnit
POSTGRES_USER=site_magnit
POSTGRES_PASSWORD=change-me-before-production
# Оставьте пустым для PostgreSQL из docker-compose или укажите внешний URL.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Админка
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_SALT=site-magnit-admin
SESSION_TTL_DAYS=14

# Медиа и уведомления (в текущем этапе можно оставить пустыми: включается безопасный fallback)
MEDIA_BASE_URL=/media
MEDIA_STORAGE_DIR=./storage/media
MEDIA_PUBLIC_URL=
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=site-magnit
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_BACKUP_RETENTION_DAYS=14
# SMTP почтового ящика отправителя. Для порта 465 используйте SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# FROM: подтверждённый адрес отправителя на домене сайта.
NOTIFICATION_EMAIL_FROM=
# TO: адрес менеджера, который должен получать заявки и заказы.
NOTIFICATION_EMAIL_TO=
# Необязательный webhook используется только для уведомлений резервного копирования.
NOTIFICATION_WEBHOOK_URL=
CONSENT_VERSION=2026-08-04

# Односторонняя синхронизация каталога из МойСклад
MOYSKLAD_SYNC_ENABLED=false
MOYSKLAD_API_URL=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_API_TOKEN=
MOYSKLAD_ACCOUNT_ID=
MOYSKLAD_SYNC_INTERVAL_MINUTES=15
